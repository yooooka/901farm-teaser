---
// Umami Cloud analytics. Only rendered in production builds so local dev
// visits are not counted. One shared website ID across 901farm.com sites.
const websiteId = "ba524589-25a5-4558-b744-a1080ef664ad";
---

{
  import.meta.env.PROD && (
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id={websiteId}
    />
  )
}
